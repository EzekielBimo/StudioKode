# Stage 1: Install PHP dependencies with Composer
FROM php:8.3-cli-alpine AS composer-deps

WORKDIR /app

RUN apk add --no-cache unzip git libzip-dev libpq-dev \
    && docker-php-ext-install pdo_pgsql pdo_mysql zip bcmath

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --optimize-autoloader --no-scripts

# Stage 2: Build frontend assets with Node
FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.* postcss.config.js tailwind.config.js ./
COPY resources ./resources
RUN npm run build

# Stage 3: Production runtime with FrankenPHP
FROM dunglas/frankenphp:1-php8.3-alpine

WORKDIR /app

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

RUN install-php-extensions pdo_pgsql pdo_mysql zip bcmath pcntl

COPY --from=composer-deps /app/vendor ./vendor
COPY --from=frontend-build /app/public/build ./public/build

COPY . .

COPY Caddyfile /etc/caddy/Caddyfile

# Ensure writable directories exist, create storage link, and clean stale bootstrap caches
RUN rm -rf bootstrap/cache/*.php \
    && mkdir -p storage/framework/cache/data \
             storage/framework/sessions \
             storage/framework/views \
             storage/logs \
             storage/app/public \
             bootstrap/cache \
    && chmod -R 777 storage bootstrap/cache \
    && rm -rf public/storage \
    && php artisan storage:link || true

# Generate clean package manifest and clear stale caches
RUN php artisan package:discover --ansi || true
RUN php artisan config:clear || true
RUN php artisan route:clear || true
RUN php artisan view:clear || true

ENV PORT=80
EXPOSE 80

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
