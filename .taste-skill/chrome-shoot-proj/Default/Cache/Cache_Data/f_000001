        <script data-page="app" type="application/json">{"component":"Projects\/Index","props":{"errors":{},"appName":"StudioKode","auth":{"user":null},"flash":{"success":null,"error":null},"projects":[{"id":6,"title":"HENERICUS CONSTANT","slug":"coastal-dune-pine-refuge","excerpt":"A vast coastal sanctuary celebrating maritime pines, wild dune grass stabilization, and weathered timber boardwalks navigating sandy terrain.","description":"Spanning over two hectares along the pristine Atlantic littoral, this sensitive coastal restoration preserves and expands fragile sand dune ecologies.\r\n\r\nElevated untreated ipe timber boardwalks hover gently above shifting white sands, guiding visitors between naturalized clusters of umbrella pine (Pinus pinea), sea lavender, and aromatic curry plants. A biological natural swimming pond filtered entirely by indigenous wetland reeds anchors the central living area without chlorine or synthetic additives.\r\n\r\nThe resulting sanctuary is an understated architectural homage to the raw maritime atmosphere of the Alentejo coast.","client":"Herdade da Costa","location":"Comporta, Portugal","year":2024,"area_size":"2,100 m\u00b2","cover_image":"https:\/\/images.unsplash.com\/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80","masterplan_image":"https:\/\/images.unsplash.com\/photo-1600566753376-12c8ab7fb75b?auto=format&fit=crop&w=1200&q=80","is_featured":true,"published_at":"2026-11-09T14:45:00.000000Z","created_at":"2026-11-11T07:45:15.000000Z","updated_at":"2026-11-11T07:48:40.000000Z","area_numeric":2100},{"id":3,"title":"Atelier Botanica Courtyard","slug":"atelier-botanica-courtyard","excerpt":"A sculptural micro-climate sanctuary within an urban heritage envelope, showcasing architectural tree ferns and blackened steel reflecting pools.","description":"Concealed within a Victorian brick warehouse conversion, this compact courtyard functions as an ethereal living lung for a contemporary design atelier.\n\nMulti-layered canopy plantings of Dicksonia antarctica tree ferns establish vertical softness against textured industrial masonry. Custom raw blackened steel water mirrors cool the ambient air temperature, while permeable bluestone gravel ensures complete on-site rainwater infiltration.\n\nSubtle under-deck lighting reveals intricate frond silhouettes during nocturnal hours, transforming the workspace into a tranquil botanical immersion.","client":"Studio K Architects","location":"Melbourne, Australia","year":2024,"area_size":"180 m\u00b2","cover_image":"https:\/\/images.unsplash.com\/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=1600&q=80","masterplan_image":"https:\/\/images.unsplash.com\/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=80","is_featured":true,"published_at":"2026-11-06T07:45:15.000000Z","created_at":"2026-11-11T07:45:15.000000Z","updated_at":"2026-11-11T07:45:15.000000Z","area_numeric":180},{"id":1,"title":"The Moss & Stone Sanctuary","slug":"moss-stone-sanctuary","excerpt":"A meditative Japanese courtyard garden balancing ancient lichen-encrusted granite, velvet bryophyte carpets, and blackened cedar pavilions.","description":"Designed as an intimate contemplative sanctuary within Kyoto's historic outskirts. The site required careful soil conditioning to sustain indigenous Polytrichum commune moss species.\n\nWeathered megalithic stones sourced from Tamba quarries define the central dry-creek rill, flanked by pruned Japanese Stewartia and weeping maples. Rainwater from the cedar pavilion is guided into a hand-carved stone tsukubai basin, creating subtle acoustic ripples throughout the courtyard.\n\nAt twilight, concealed brass luminaires cast soft shadows through bamboo screens, accentuating the undulating topography of green moss hummocks against dark river pebbles.","client":"Private Collector","location":"Kyoto, Japan","year":2024,"area_size":"380 m\u00b2","cover_image":"https:\/\/images.unsplash.com\/photo-1503899036084-c55cdd92da26?auto=format&fit=crop&w=1600&q=80","masterplan_image":"https:\/\/images.unsplash.com\/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80","is_featured":true,"published_at":"2026-10-30T07:45:15.000000Z","created_at":"2026-11-11T07:45:15.000000Z","updated_at":"2026-11-11T07:45:15.000000Z","area_numeric":380},{"id":5,"title":"Oasis Dune Residence","slug":"oasis-dune-residence","excerpt":"Sculptural desert xeriscaping harmonizing rammed-earth windbreaks, specimen agaves, and pale gravel swales with mid-century lines.","description":"Responding to the extreme diurnal temperature shifts of the Sonoran Desert, this landscape celebrates the bold sculptural silhouettes of arid botanical species.\n\nMassive rammed-earth retaining walls buffer harsh seasonal desert winds and cast long geometric shadows across polished concrete patios. A curated collection of specimen blue glow agaves, golden barrel cacti, and thornless palo verde trees rise from decomposed granite beds designed for ephemeral flash-rain harvesting.\n\nDusk brings the space alive as architectural up-lighting transforms the desert spires into dramatic sculptural monuments against the San Jacinto mountains.","client":"Vance & Morgan Design","location":"Palm Springs, California","year":2023,"area_size":"620 m\u00b2","cover_image":"https:\/\/images.unsplash.com\/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=1600&q=80","masterplan_image":"https:\/\/images.unsplash.com\/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80","is_featured":false,"published_at":"2026-09-12T07:45:15.000000Z","created_at":"2026-11-11T07:45:15.000000Z","updated_at":"2026-11-11T07:45:15.000000Z","area_numeric":620},{"id":2,"title":"Verdant Terrace Estate","slug":"verdant-terrace-estate","excerpt":"Cascading limestone terraces descending toward Lake Como, punctuated by columnar cypresses, fragrant citrus groves, and neoclassical water rills.","description":"Revitalizing a historic 19th-century hillsid